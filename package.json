{
  "name": "sow-post-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SOW Post Generator — Dynamic EcoHome. Salesforce paste + 4 notes -> standardized Slack handoff post.",
  "scripts": {
    "dev": "netlify dev",
    "dev:vite": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src netlify",
    "check:nosecrets": "node scripts/check-no-secrets.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react": "0.27.20",
    "@netlify/blobs": "^11.1.1",
    "@tanstack/react-table": "8.21.3",
    "exceljs": "^4.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@netlify/functions": "^5.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.3.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "zod": "^4.4.3"
  }
}
