# Copy to .env for local `netlify dev`. NEVER commit .env.
# On Netlify: Site settings -> Environment variables (same names).

# Server-side only — never reaches the client bundle.
OPENAI_API_KEY=sk-REPLACE_ME

# Model ids, changeable without a deploy.
OPENAI_MODEL_VISION=gpt-4o
OPENAI_MODEL_TEXT=gpt-4o-mini

# Comma-separated. Production site URL + local netlify dev origin.
ALLOWED_ORIGINS=http://localhost:8888

# Short random string used in the function paths (/api/<token>/rewrite).
# Must equal VITE_API_PATH_TOKEN below. Generate with:
#   node -e "console.log(crypto.randomBytes(6).toString('hex'))"
API_PATH_TOKEN=changeme

# Build-time copy of API_PATH_TOKEN for the client (Vite exposes VITE_* only).
VITE_API_PATH_TOKEN=changeme

# ---- Project Board (10-project-board.md §3) --------------------------------
# Client-side, PUBLIC BY DESIGN — row-level security protects the data.
# From Supabase: Project settings -> API.
VITE_SUPABASE_URL=https://REPLACE.supabase.co
VITE_SUPABASE_ANON_KEY=REPLACE_ME

# Functions only — NEVER VITE_-prefixed, never in the client bundle.
# check:nosecrets fails the build if the service key leaks into dist/.
SUPABASE_URL=https://REPLACE.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
